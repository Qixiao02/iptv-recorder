# IPTV Recorder 密钥配置模板
#
# 复制为 .env 并填入真实值,或运行 scripts/generate-env.{sh,ps1} 自动生成。
# .env 文件已被 .gitignore 忽略,不会被提交。

# JWT 签名密钥(至少 32 字符)。更换后所有已签发的 token 立即失效。
# 生产环境必须修改!可用命令生成:openssl rand -hex 32
IPTV_JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-chars

# 初始管理员密码(首次启动创建 admin 账号时使用,登录后请立即修改)。
# 不设置则后端自动生成随机密码并记录到日志。
IPTV_INITIAL_ADMIN_PASSWORD=please-change-me

# ──────────────────────────────────────────────────────────────
# 容器运行用户 UID/GID(NAS/Linux 部署用,与宿主用户对齐避免权限问题)
#
# 镜像采用 PUID/PGID 动态用户(参照 jellyfin/sonarr):容器启动时按这两个
# 值调整 app 用户的 uid/gid,使容器进程与宿主当前用户对齐 → 挂载卷都能读写,
# 根除"app 用户写不进 root 属主目录 → SQLite code 14"的崩溃。
#
# 在 NAS/Linux 上执行 `id` 看 uid 和 gid(飞牛 wren 用户通常是 1000:1000):
#   $ id
#   uid=1000(wren) gid=1000(Users) ...
# 把对应数字填进来即可。开发机可不设(走默认 1000:1000)。
# ──────────────────────────────────────────────────────────────
PUID=1000
PGID=1000
